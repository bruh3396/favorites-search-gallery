{
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.8",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.25.1",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.12.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "eslintIgnore": [
    "dist",
    "node_modules"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "scripts": {
    "build": "node scripts/bin/build || (npm run compile-scripts && node scripts/bin/build)",
    "build:playground": "esbuild playground/playground.ts --bundle --format=iife --target=esnext --define:USE_LOCAL_SERVER=false --define:SCRIPT_VERSION=\\\"playground\\\" --loader:.svg=text --loader:.css=text --loader:.html=text --outfile=dist/playground/playground.js",
    "build:demo": "npm run compile-scripts && node scripts/bin/build demo",
    "build:electron": "npm run compile-scripts && node scripts/bin/build electron",
    "electron": "npm run build:electron && electron dist/electron/launcher.js",
    "build:kit": "vite build --config src/targets/kit/vite.config.mts",
    "kit": "vite --config src/targets/kit/vite.config.mts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project src/targets/electron/tsconfig.json --noEmit",
    "test:coverage": "npx vitest --run --coverage",
    "test": "npx vitest --run",
    "test:frozen-cobalt": "npx vitest --run --config checks/vitest.config.mts checks/frozen_cobalt.test.ts",
    "lint": "npx eslint src/",
    "continuous-integration": "npm run build && npm run test:coverage && npm run typecheck",
    "release-checks:ci": "npm run compile-scripts &&npm run continuous-integration && npm run lint",
    "release-checks:local": "npm run release-checks:ci && npm run test:frozen-cobalt",
    "release": "npm run compile-scripts && node scripts/bin/release",
    "release:patch": "npm run release -- patch",
    "release:minor": "npm run release -- minor",
    "release:major": "npm run release -- major",
    "compile-scripts": "tsc --project scripts/tsconfig.json",
    "delete-compiled-scripts": "if exist scripts\\bin del /q scripts\\bin\\*.js",
    "fix-bom": "python .scripts/correct_bom.py",
    "visualize": "esbuild-visualizer --metadata dist/rule34/meta.json --template treemap --filename dist/rule34/stats.html --open"
  },
  "dependencies": {
    "awesomplete": "^1.1.7"
  }
}
