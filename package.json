{
  "imports": {
    "#architecture/*": "./architecture/*"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.8",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.25.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-functional": "^10.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.12.2",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^5.0.2"
  },
  "eslintIgnore": [
    "dist",
    "node_modules"
  ],
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "scripts": {
    "build": "node build/bin/build || (npm run compile-build && node build/bin/build)",
    "build:demo": "esbuild src/targets/demo/main.ts --bundle --format=iife --target=esnext --define:USE_LOCAL_SERVER=false --define:SCRIPT_VERSION=\\\"demo\\\" --loader:.svg=text --loader:.css=text --loader:.html=text --outfile=dist/demo/demo.js && node -e \"require('fs').copyFileSync('src/targets/demo/index.html','dist/demo/index.html')\"",
    "build:playground": "esbuild src/playground/playground.ts --bundle --format=iife --target=esnext --define:USE_LOCAL_SERVER=false --define:SCRIPT_VERSION=\\\"playground\\\" --loader:.svg=text --loader:.css=text --loader:.html=text --outfile=dist/playground.js",
    "test": "npx vitest --run",
    "test:coverage": "npx vitest --run --coverage",
    "test:api": "npx vitest --run --config src/playground/vitest.config.mts src/playground/junk/api.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "npx eslint src/",
    "architecture:test": "npx vitest --run --config architecture/vitest.config.mjs",
    "architecture:lint": "npx eslint --no-config-lookup --no-inline-config -c architecture/eslint/eslint.config.mjs --suppressions-location architecture/eslint/suppressions.json src/",
    "architecture:typecheck": "tsc --project architecture/tsconfig/core.json",
    "architecture": "npm run architecture:test && npm run architecture:typecheck && npm run architecture:lint",
    "audit:test":"npx vitest --run --config .audit/vitest.config.mjs",
    "audit:lint": "npx eslint --no-config-lookup -c .audit/lint/eslint.config.mjs --suppressions-location .audit/lint/suppressions.json src/",
    "audit:structure": "tsx .audit/structure/main.ts",
    "audit": "npm run audit:test && npm run audit:lint && npm run audit:structure",
    "continuous-integration": "npm run build && npm run test:coverage && npm run typecheck",
    "release-checks:ci": "npm run compile-build && npm run continuous-integration && npm run lint",
    "release-checks:local": "npm run release-checks:ci && npm run audit && npm run architecture && npm run test:api",
    "release": "python .scripts/release.py",
    "release:patch": "npm run release -- patch",
    "release:minor": "npm run release -- minor",
    "release:major": "npm run release -- major",
    "release:test": "npm run release -- test",
    "release:cleanup": "npm run release -- cleanup",
    "compile-build": "tsc --project build/tsconfig.json",
    "delete-compiled-build": "if exist build\\bin del /q build\\bin\\*.js",
    "fix-bom": "python .scripts/correct_bom.py",
    "visualize": "esbuild-visualizer --metadata dist/meta.json --template treemap --filename dist/stats.html --open"
  },
  "dependencies": {
    "awesomplete": "^1.1.7"
  }
}
