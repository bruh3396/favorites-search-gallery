{
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.8",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.25.1",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.12.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "scripts": {
    "build": "npm run compile-scripts && node scripts/bin/build",
    "build:playground": "esbuild playground/playground.ts --bundle --format=iife --target=esnext --define:USE_LOCAL_SERVER=false --define:SCRIPT_VERSION=\\\"playground\\\" --loader:.svg=text --loader:.css=text --loader:.html=text --outfile=dist/playground/playground.js",
    "electron": "npm run build && electron dist/electron/launcher.js",
    "build:kit": "vite build --config src/targets/kit/vite.config.mts",
    "kit": "vite --config src/targets/kit/vite.config.mts",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project src/targets/electron/tsconfig.json --noEmit",
    "test": "vitest --run --coverage",
    "test:frozen-cobalt": "vitest --run --config checks/vitest.config.mts checks/frozen_cobalt.test.ts",
    "check:siblings": "node scripts/bin/test_siblings",
    "lint": "eslint src/",
    "sort-imports": "node checks/import_sorter.cjs src",
    "check:names": "node checks/convention_checker.cjs names",
    "check:props": "node checks/convention_checker.cjs props",
    "check:titles": "node checks/convention_checker.cjs titles",
    "check:conventions": "node checks/convention_checker.cjs",
    "verify": "npm run test && npm run check:siblings && npm run typecheck && npm run lint",
    "continuous-integration": "npm run build && node scripts/bin/check_runner",
    "release-checks": "npm run continuous-integration && npm run test:frozen-cobalt",
    "release": "npm run compile-scripts && node scripts/bin/release",
    "release:patch": "npm run release -- patch",
    "release:minor": "npm run release -- minor",
    "release:major": "npm run release -- major",
    "compile-scripts": "tsc --project scripts/tsconfig.json",
    "visualize": "esbuild-visualizer --metadata dist/rule34/meta.json --template treemap --filename dist/rule34/stats.html --open"
  }
}
