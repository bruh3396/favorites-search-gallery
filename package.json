{
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^25.6.0",
    "@types/sqlite3": "^5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@xmldom/xmldom": "^0.9.10",
    "esbuild": "^0.25.2",
    "esbuild-visualizer": "^0.7.0",
    "eslint": "^9.25.1",
    "globals": "^15.15.0",
    "knip": "^6.12.2",
    "sqlite3": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.3"
  },
  "eslintIgnore": [
    "dist",
    "node_modules"
  ],
  "scripts": {
    "compile-scripts": "tsc --project scripts/tsconfig.json",
    "delete-compiled-scripts": "if exist scripts\\bin del /q scripts\\bin\\*.js",
    "build": "node scripts/bin/userscript_builder || (npm run compile-scripts && node scripts/bin/userscript_builder)",
    "test": "npx vitest --run --exclude \"src/tests/playground/**\"",
    "test-local-server": "npx vitest --run src/tests/playground/local_server.test.ts",
    "test-post-contract": "npx vitest --run src/tests/playground/post_contract.test.ts",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "continuous-integration": "npm run build && npm run test && npm run typecheck",
    "lint": "npx eslint src/",
    "audit": "tsx .scripts/project_auditor.ts",
    "release": "npm run compile-scripts && npm run continuous-integration && npm run lint && npm run audit",
    "fix-lf": "tsx .scripts/normalize_line_endings.ts",
    "fix-bom": "python .scripts/correct_bom.py",
    "visualize": "esbuild-visualizer --metadata dist/meta.json --template treemap --filename dist/stats.html --open",
    "performance": "tsx src/tests/search/performance.ts",
    "build-playground": "esbuild src/tests/playground/playground.ts --bundle --format=iife --target=esnext --define:USE_LOCAL_SERVER=false --define:SCRIPT_VERSION=\\\"playground\\\" --loader:.svg=text --loader:.css=text --loader:.html=text --outfile=dist/playground.js"
  },
  "dependencies": {
    "strip-ansi": "^7.1.0"
  }
}
